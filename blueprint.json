{
  "schemaVersion": 3,
  "id": "long-task-simple",
  "version": "1.0.0",
  "title": "long-task-simple",
  "description": "long-task-lite 的极简变体：去 SRS / Design / wd 特性设计文档，唯一权威需求源 = 用户输入文档（original-requirements.md）。bdd 节点据用户输入文档产出 BDD 可执行规约（bdd.json）作为对抗验证 oracle；BDD-xxx 场景 id 是下游验证溯源货币（无 FR-id / srs.md / design.md）。decompose 按用户需求切 work-unit、每个 task 带需求文档锚点 req_refs（bdd_ids 随附但仅供验证）；init 生成带 req_refs + bdd_ids 的 task。iter loop 体内 impl → ut → review → gate_review 四节点：impl 以 original-requirements.md 为权威、按 req_refs 必读，只写实现、不写测试，不读 bdd.json；ut 据 bdd.json 独立写对抗测试（BDD-id 标记 + then/examples 精确可观察值）；review 是 LLM 对抗审查者，用 sub-agent 并行按 task.bdd_ids 分块核 impl 行为与 ut 测试是否忠实 BDD，汇总落 .harness/memory/notes/feature-<id>-review-r<N>.md；gate_review 脚本机检硬门：真跑测试 + grep BDD id 覆盖 + 断言深度 + then 精确值命中（测试由独立 ut 所写，机检合法），test 维折返 ut、impl 维折返 impl。末段 st + gate_st 在真实集成环境逐条 replay 全部 BDD 场景并对账。",
  "startNode": "scan",
  "nodes": [
    {
      "id": "scan",
      "title": "代码库约定扫描",
      "x": 100,
      "y": 100
    },
    {
      "id": "bdd",
      "title": "用户输入 → BDD 可执行规约",
      "x": 320,
      "y": 100
    },
    {
      "id": "gate_bdd",
      "title": "BDD 规范性硬门",
      "x": 540,
      "y": 100,
      "onFail": {
        "rewindTo": "bdd",
        "ticketTitle": "BDD 用例不规范 — 见校验报告",
        "maxAttempts": 10,
        "when": "status != \"ok\""
      }
    },
    {
      "id": "decompose",
      "title": "BDD→feature 分组（按预算贪心填充）",
      "x": 760,
      "y": 100
    },
    {
      "id": "gate_decompose",
      "title": "Decompose 硬门（含过度碎片化判定）",
      "x": 980,
      "y": 100,
      "onFail": {
        "rewindTo": "decompose",
        "ticketTitle": "feature-plan 不达标（BDD 覆盖/预算/过度碎片化）— 见校验报告，按提示 S5 聚合或拆分",
        "maxAttempts": 10,
        "when": "status != \"ok\""
      }
    },
    {
      "id": "init",
      "title": "初始化 + 灌入 iter",
      "x": 1200,
      "y": 100
    },
    {
      "id": "gate_init",
      "title": "Init 硬门",
      "x": 1420,
      "y": 100,
      "onFail": {
        "rewindTo": "init",
        "ticketTitle": "Init 产物不达标",
        "maxAttempts": 10,
        "when": "status != \"ok\""
      }
    },
    {
      "id": "iter",
      "kind": "loop",
      "title": "按 feature 迭代：impl → ut → review → gate_review",
      "x": 1640,
      "y": 100,
      "iterator": {
        "kind": "tasks",
        "tasksSchemaRef": "default",
        "selectStrategy": "first-pending"
      },
      "body": {
        "startNode": "impl",
        "nodes": [
          {
            "id": "impl",
            "kind": "skill",
            "title": "据需求文档实现（不写测试）",
            "x": 100,
            "y": 100
          },
          {
            "id": "ut",
            "kind": "skill",
            "title": "据 BDD 写对抗测试",
            "x": 210,
            "y": 100
          },
          {
            "id": "review",
            "kind": "skill",
            "title": "对抗式 Review（并行 + 汇总）",
            "x": 320,
            "y": 100,
            "onFail": {
              "candidates": [
                {
                  "when": "status != \"ok\" && notes has \"FAILKIND: test\"",
                  "rewindTo": "ut",
                  "ticketTitle": "测试不忠实 spec — 回 ut 修测试断言对齐 then 的 observable（错轴/错字段/race/错 setup），勿改业务实现",
                  "maxAttempts": 10
                },
                {
                  "when": "status != \"ok\"",
                  "rewindTo": "impl",
                  "ticketTitle": "Review 未通过 — 见 .harness/memory/notes/feature-<id>-review-r<N>.md 定点修正",
                  "maxAttempts": 10
                }
              ]
            }
          },
          {
            "id": "gate_review",
            "kind": "skill",
            "title": "脚本机检硬门",
            "x": 540,
            "y": 100,
            "onFail": {
              "candidates": [
                {
                  "when": "status != \"ok\" && notes has \"FAILKIND: test\"",
                  "rewindTo": "ut",
                  "ticketTitle": "测试编写缺口（漏 BDD id / 断言过浅 / then 精确值无命中）— 回 ut 补/修测试，勿改业务实现",
                  "maxAttempts": 10
                },
                {
                  "when": "status != \"ok\"",
                  "rewindTo": "impl",
                  "ticketTitle": "Gate_review 机检未通过（测试不绿 / 边界契约违约）— 回 impl 修实现",
                  "maxAttempts": 10
                }
              ]
            }
          }
        ],
        "edges": [
          {
            "from": "impl",
            "to": "ut",
            "when": "status == \"ok\""
          },
          {
            "from": "ut",
            "to": "review",
            "when": "status == \"ok\""
          },
          {
            "from": "review",
            "to": "gate_review",
            "when": "status == \"ok\""
          }
        ]
      },
      "maxIterations": 50
    },
    {
      "id": "st",
      "title": "系统测试 + BDD 对账",
      "x": 1860,
      "y": 100,
      "onFail": {
        "rewindTo": "iter",
        "ticketTitle": "ST 发现真实缺陷 — 已建 bugfix-task，回 iter 修复后重对账",
        "maxAttempts": 10,
        "when": "status == \"failed\""
      }
    },
    {
      "id": "gate_st",
      "title": "ST BDD 对账硬门",
      "x": 2080,
      "y": 100,
      "onFail": {
        "rewindTo": "st",
        "ticketTitle": "ST BDD 对账未通过 — 见未对账/FAIL 的场景清单",
        "maxAttempts": 10,
        "when": "status != \"ok\""
      }
    }
  ],
  "edges": [
    {
      "from": "scan",
      "to": "bdd",
      "when": "status == \"ok\""
    },
    {
      "from": "bdd",
      "to": "gate_bdd",
      "when": "status == \"ok\""
    },
    {
      "from": "gate_bdd",
      "to": "decompose"
    },
    {
      "from": "decompose",
      "to": "gate_decompose",
      "when": "status == \"ok\""
    },
    {
      "from": "gate_decompose",
      "to": "init"
    },
    {
      "from": "init",
      "to": "gate_init",
      "when": "status == \"ok\""
    },
    {
      "from": "gate_init",
      "to": "iter"
    },
    {
      "from": "iter",
      "to": "st"
    },
    {
      "from": "st",
      "to": "gate_st",
      "when": "status == \"ok\""
    }
  ],
  "tasksSchemas": {
    "default": {
      "requiredFields": {
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "status": {
          "type": "string",
          "default": "failing"
        }
      },
      "recommendedFields": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "dependencies": {
          "type": "array"
        }
      },
      "userFields": {
        "category": {
          "type": "string"
        },
        "risk": {
          "type": "string",
          "enum": [
            "critical",
            "normal",
            "trivial"
          ],
          "description": "业务风险等级，继承自所属 feature（bdd.json feature.risk）；critical 路径需 ≥1 happy + ≥N negative + 独立验证证据，下游 gate_bdd/gate_st 按此分层判定；详见 shared-reference/risk-tagging-guide.md"
        },
        "req_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "权威需求锚点（impl 据此读 original-requirements.md 对应片段实现，必读）：每项形如 \"original-requirements.md L<起>-L<止> | <一句摘要>\" 或 scan 约定 file:line。本蓝图 impl 的唯一行为权威源；bdd_ids 仅供下游验证。"
        },
        "bdd_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "覆盖的 BDD 场景 id（仅供 ut/review/gate_review/st 验证用，非 impl 实现依据）。"
        },
        "verification_steps": {
          "type": "array"
        },
        "tech_stack": {
          "type": "object"
        },
        "single_round": {
          "type": "boolean"
        }
      },
      "extensionFieldsAllowed": true,
      "doneValues": [
        "passing"
      ],
      "example": {
        "id": 1,
        "title": "登录表单组件",
        "status": "failing",
        "priority": "high",
        "category": "core",
        "risk": "critical",
        "description": "邮箱 + 密码字段、必填校验、submit 触发回调",
        "req_refs": [
          "original-requirements.md L12-L28 | 登录表单字段与校验规则",
          "original-requirements.md L40-L46 | 登录成功后的回调与会话"
        ],
        "bdd_ids": [
          "BDD-001",
          "BDD-007"
        ],
        "dependencies": [],
        "verification_steps": [
          "页面渲染表单",
          "空提交报错",
          "成功 submit 调回调"
        ]
      }
    }
  }
}
